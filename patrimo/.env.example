# ---------------------------------------------------------------------------
# Patrimo — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs.
# ---------------------------------------------------------------------------

# Base de donnees PostgreSQL.
# En docker-compose, l'hote est le nom du service `db`.
DATABASE_URL="postgresql://patrimo:CHANGE_ME@db:5432/patrimo?schema=public"
POSTGRES_USER="patrimo"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="patrimo"

# Secret de signature des cookies de session.
# Generer avec : openssl rand -base64 48
SESSION_SECRET=""

# Cle de chiffrement des donnees sensibles au repos (IBAN, credentials connecteurs).
# 32 octets en base64. Generer avec : openssl rand -base64 32
# ATTENTION : changer cette cle rend illisibles toutes les donnees deja chiffrees.
ENCRYPTION_KEY=""

# Duree de validite de la session, en heures.
SESSION_TTL_HOURS="720"

# --- Categorisation par IA (optionnelle) -----------------------------------
# Sans cle, l'application se rabat sur les regles deterministes uniquement.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Connecteur Trade Republic (non officiel) ------------------------------
# Le connecteur s'appuie sur `pytr`, un client Python non officiel.
# Renseigner le chemin de l'executable Python de l'environnement ou pytr est installe.
# Laisser vide pour desactiver le connecteur.
PYTR_PYTHON="/opt/pytr-venv/bin/python"
TR_PHONE=""          # format international, ex. +33612345678
TR_PIN=""            # code PIN a 4 chiffres de l'application Trade Republic

# --- Fournisseur de cotations ----------------------------------------------
# Utilise pour valoriser les positions et comparer aux indices.
# Valeurs possibles : "stooq" (gratuit, sans cle) ou "none".
QUOTES_PROVIDER="stooq"

# --- Divers -----------------------------------------------------------------
TZ="Europe/Paris"
# URL publique de l'application, utilisee par le manifest PWA.
APP_URL="https://finance.exemple.fr"
